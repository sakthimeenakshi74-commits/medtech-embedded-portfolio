mach create "STM32F401_Sim"
machine LoadPlatformDescription @C:/STMPRO~1/I2C_MLX90614_TempMonitor/stm32f401_mlx.repl

python "import System; t1_list = [int((t + 273.15) / 0.02) for t in [25.0, 27.5, 30.0, 33.2, 36.5, 38.0, 36.5, 32.0, 28.0, 25.0]]; t2_list = [int((t + 273.15) / 0.02) for t in [24.0, 24.2, 24.5, 25.0, 25.8, 26.5, 26.0, 25.2, 24.5, 24.0]]; payload = [b for v1, v2 in zip(t1_list, t2_list) for b in (v1 & 0xFF, (v1 >> 8) & 0xFF, 0x00, v2 & 0xFF, (v2 >> 8) & 0xFF, 0x00)]; self.Machine['sysbus.i2c1.mlx90614'].EnqueueResponseBytes(System.Array[System.Byte](payload * 50))"

# Open Renode's native UART terminal for USART2 (no external Python script needed)
showAnalyzer sysbus.usart2

macro reset
"""
    sysbus LoadELF @C:/STMPRO~1/I2C_MLX90614_TempMonitor/Debug/I2C_MLX90614_TempMonitor.elf
"""
runMacro $reset

start
