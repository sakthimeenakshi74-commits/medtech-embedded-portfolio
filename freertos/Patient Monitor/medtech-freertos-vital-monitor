/* ========================================================================== */
/*                        ALERT & DISPLAY TASKS                               */
/* ========================================================================== */

/**
 * @brief Multi-vital critical alert aggregation task.
 * @details Blocks on the event group waiting for ANY vital to breach its
 *          clinical threshold. Uses pdFALSE (OR-wait) so any single abnormal
 *          vital triggers an immediate response. All alerts are routed through
 *          the stream buffer for unified, persistent logging.
 * @param pvParameter FreeRTOS task parameter — unused.
 * @note   pdTRUE clears bits after reading — resets for next event cycle.
 *         Higher priority than sensor tasks ensures preemptive response.
 * @priority 5
 */
void vCriticalAlert(void *pvParameter) {
    char cTxBuffer[128];

    while(1) {
        /* Block until ANY vital parameter exceeds its clinical threshold */
        EventBits_t bits = xEventGroupWaitBits(
            xVitalAlertGroup,
            BIT_HR_ABNORMAL | BIT_SpO2_ABNORMAL |
            BIT_BP_ABNORMAL | BIT_TEMP_ABNORMAL,
            pdTRUE,       /* Clear bits after reading — reset for next event */
            pdFALSE,      /* OR-wait: ANY single bit is sufficient to unblock */
            portMAX_DELAY /* Block indefinitely until an alert fires */
        );

        /* Route each triggered alert through the unified telemetry pipeline */
        if (bits & BIT_HR_ABNORMAL) {
            if (xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                                   "[CRITICAL] Heart Rate abnormal!\n");
                if (len > 0) xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
                xSemaphoreGive(xBufferMutex);
            } else { vLogError(ERR_MUTEX_TIMEOUT, "CritAlert: BufferMutex timeout"); }
        }
        if (bits & BIT_SpO2_ABNORMAL) {
            if (xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                                   "[CRITICAL] SpO2 abnormal!\n");
                if (len > 0) xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
                xSemaphoreGive(xBufferMutex);
            } else { vLogError(ERR_MUTEX_TIMEOUT, "CritAlert: BufferMutex timeout"); }
        }
        if (bits & BIT_BP_ABNORMAL) {
            if (xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                                   "[CRITICAL] BP abnormal!\n");
                if (len > 0) xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
                xSemaphoreGive(xBufferMutex);
            } else { vLogError(ERR_MUTEX_TIMEOUT, "CritAlert: BufferMutex timeout"); }
        }
        if (bits & BIT_TEMP_ABNORMAL) {
            if (xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                                   "[CRITICAL] Temperature abnormal!\n");
                if (len > 0) xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
                xSemaphoreGive(xBufferMutex);
            } else { vLogError(ERR_MUTEX_TIMEOUT, "CritAlert: BufferMutex timeout"); }
        }
    }
}

/**
 * @brief Secondary UI notification display task.
 * @details Receives direct task notifications from sensor tasks when vitals
 *          breach clinical thresholds. Provides a lightweight secondary alert
 *          channel parallel to the critical alert task. Uses xTaskNotifyWait
 *          with full 32-bit clear mask to consume all pending notification bits.
 * @param pvParameter FreeRTOS task parameter — unused.
 * @note   Task notifications have zero heap overhead vs semaphores and execute
 *         up to 45% faster — ideal for high-frequency UI update signaling.
 * @priority 1 — lowest priority, runs only during idle periods
 */
void vDisplayTask(void *pvParameter) {
    uint32_t ulNotificationValue;

    while(1) {
        /* Block until any sensor task sends a direct notification */
        xTaskNotifyWait(
            0,           /* Don't clear bits on entry */
            0xFFFFFFFF,  /* Clear all bits on exit */
            &ulNotificationValue,
            portMAX_DELAY
        );

        /* Print corresponding UI alert for each set notification bit */
        if (ulNotificationValue & NOTIFY_HR_ALERT) {
            if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                printf("[Notify] Heart Rate needs attention\n");
                xSemaphoreGive(xPrintMutex);
            }
        }
        if (ulNotificationValue & NOTIFY_SPO2_ALERT) {
            if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                printf("[Notify] SpO2 needs attention\n");
                xSemaphoreGive(xPrintMutex);
            }
        }
        if (ulNotificationValue & NOTIFY_BP_ALERT) {
            if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                printf("[Notify] BP needs attention\n");
                xSemaphoreGive(xPrintMutex);
            }
        }
        if (ulNotificationValue & NOTIFY_TEMP_ALERT) {
            if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                printf("[Notify] Temperature needs attention\n");
                xSemaphoreGive(xPrintMutex);
            }
        }
    }
}

/* ========================================================================== */
/*                        SYSTEM MONITORING TASKS                             */
/* ========================================================================== */

/**
 * @brief System fault handler — initiates controlled safe shutdown sequence.
 * @details Called by the watchdog task when one or more sensor tasks fail to
 *          check in within the monitoring window. Prints a staff alert and
 *          halts the system. In production hardware, this function would stop
 *          kicking the hardware IWDG (Independent Watchdog), triggering an
 *          automatic MCU hardware reset via the watchdog peripheral.
 * @note   while(1) here represents the halted-pending-hardware-reset state.
 *         On STM32: stop calling HAL_IWDG_Refresh() → hardware resets chip.
 *         On ESP32: stop calling esp_task_wdt_reset() → hardware resets chip.
 */
void vSafeShutdown(void) {
    printf("[SYSTEM] Critical failure detected!\n");
    printf("[SYSTEM] *** ALERT — STAFF NEEDED IMMEDIATELY ***\n");
    printf("[SYSTEM] Initiating safe shutdown — hardware reset pending...\n");
    while(1); /* Halt: in production hardware, IWDG resets MCU from here */
}

/**
 * @brief High-priority software watchdog task.
 * @details Monitors liveness of all four sensor tasks by checking a shared
 *          bitmask register. Each sensor task ORs its assigned bit into
 *          ulWatchdogKickRegister every cycle. If any bit is missing after
 *          a 5-second window, the corresponding task has hung or crashed,
 *          and safe shutdown is triggered.
 * @param pvParameter FreeRTOS task parameter — unused.
 * @note   Priority 6 — highest in the system. Must never be starved or
 *         delayed by lower-priority tasks to maintain timing integrity.
 *         The kick register is reset to zero after each check window.
 * @priority 6
 */
void vWatchDogTask(void *pvParameter) {
    while(1) {
        /* Watchdog monitoring window — all tasks must kick within this period */
        vTaskDelay(pdMS_TO_TICKS(5000));

        if (ulWatchdogKickRegister != WATCHDOG_ALL_BITS) {
            /* Identify and log which specific tasks failed to respond */
            if (!(ulWatchdogKickRegister & WATCHDOG_HR))
                vLogError(ERR_WATCHDOG_TIMEOUT, "Watchdog: HR task not responding");
            if (!(ulWatchdogKickRegister & WATCHDOG_SPO2))
                vLogError(ERR_WATCHDOG_TIMEOUT, "Watchdog: SpO2 task not responding");
            if (!(ulWatchdogKickRegister & WATCHDOG_BP))
                vLogError(ERR_WATCHDOG_TIMEOUT, "Watchdog: BP task not responding");
            if (!(ulWatchdogKickRegister & WATCHDOG_TEMP))
                vLogError(ERR_WATCHDOG_TIMEOUT, "Watchdog: Temp task not responding");

            vSafeShutdown(); /* Initiate controlled fault recovery */
        } else {
            /* All sensor tasks healthy — log system status */
            if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
                printf("[Watchdog] All tasks alive — system nominal\n");
                xSemaphoreGive(xPrintMutex);
            }
        }

        /* Reset register for next 5-second monitoring window */
        ulWatchdogKickRegister = 0;
    }
}

/**
 * @brief Periodic system health diagnostics task.
 * @details Prints the full FreeRTOS task state table and heap statistics
 *          every 10 seconds. Provides runtime visibility into task states,
 *          stack high water marks, and remaining heap — essential for
 *          IEC 62304 software verification and system stress testing.
 * @param pvParameter FreeRTOS task parameter — unused.
 * @note   Requires configUSE_TRACE_FACILITY = 1 and
 *         configUSE_STATS_FORMATTING_FUNCTIONS = 1 in FreeRTOSConfig.h.
 *         Stack size of 2048 words required — vTaskList() uses significant stack.
 * @priority 1
 */
void vHealthMonitor(void *pvParameter) {
    char pcBuffer[2048]; /* Buffer sized for vTaskList() output */

    while(1) {
        vTaskDelay(pdMS_TO_TICKS(10000)); /* 10-second diagnostic interval */

        if (xSemaphoreTake(xPrintMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
            printf("\n========= SYSTEM HEALTH REPORT =========\n");

            /* Task state table: Name | State | Priority | Stack HWM | Num */
            vTaskList(pcBuffer);
            printf("%s\n", pcBuffer);

            /* Heap memory diagnostics */
            printf("Free Heap: %u bytes remaining\n",
                   (unsigned int)xPortGetFreeHeapSize());

            printf("=========================================\n\n");
            xSemaphoreGive(xPrintMutex);
        }
    }
}

/**
 * @brief Single-consumer telemetry stream logging task.
 * @details Drains the shared xLogStreamBuffer and outputs each received
 *          message to the console. Acts as the single consumer in a
 *          multi-producer single-consumer (MPSC) logging pipeline.
 *          Null-terminates each received chunk before printing.
 * @param pvParameter FreeRTOS task parameter — unused.
 * @note   Stream buffers enforce a single-reader contract. xBufferMutex
 *         serializes the multiple producer writes on the send side.
 *         Buffer sized at 129 bytes (128 + null terminator).
 * @priority 1
 */
void vLoggingtask(void *pvParameter) {
    char  cRxBuffer[128 + 1]; /* +1 for null terminator */
    size_t xReceivedBytes;

    while(1) {
        /* Block until bytes arrive in the stream buffer */
        xReceivedBytes = xStreamBufferReceive(
            xLogStreamBuffer,
            cRxBuffer,
            sizeof(cRxBuffer) - 1, /* Leave room for null terminator */
            portMAX_DELAY
        );

        if (xReceivedBytes > 0) {
            cRxBuffer[xReceivedBytes] = '\0'; /* Null-terminate for safe printf */
            printf("%s", cRxBuffer);
        }
    }
}

/* ========================================================================== */
/*                        SYSTEM ENTRY POINT                                  */
/* ========================================================================== */

/**
 * @brief System initialization and FreeRTOS scheduler entry point.
 * @details Creates all FreeRTOS synchronization objects and tasks in the
 *          correct dependency order. Every creation is validated against
 *          NULL or pdPASS — any failure triggers a fatal halt, consistent
 *          with IEC 62304 defensive initialization requirements.
 *
 *          Initialization Order:
 *          1. Stream buffer    — must exist before logging task starts
 *          2. Mutexes          — must exist before any task calls vLogError
 *          3. Event group      — must exist before sensor tasks start
 *          4. Logging task     — must be running before sensor tasks send data
 *          5. Sensor tasks     — HR, SpO2, BP, Temperature
 *          6. Alert tasks      — Critical alert, Display
 *          7. System tasks     — Watchdog (highest priority), Health monitor
 *          8. Scheduler start  — transfers control to FreeRTOS kernel
 *
 * @return  Never returns — control is transferred to vTaskStartScheduler().
 */
int main(void) {

    /* ── Stream Buffer ───────────────────────────────────────────────────── */
    /* Must be created first — logging task and vLogError depend on it       */
    xLogStreamBuffer = xStreamBufferCreate(1024, 1);
    if (xLogStreamBuffer == NULL) {
        printf("[FATAL] Stream buffer creation failed — halting\n");
        while(1);
    }

    /* ── Mutexes ─────────────────────────────────────────────────────────── */
    xPrintMutex = xSemaphoreCreateMutex();
    if (xPrintMutex == NULL) {
        printf("[FATAL] Print mutex creation failed — halting\n");
        while(1);
    }

    xBufferMutex = xSemaphoreCreateMutex();
    if (xBufferMutex == NULL) {
        printf("[FATAL] Buffer mutex creation failed — halting\n");
        while(1);
    }

    /* ── Event Group ─────────────────────────────────────────────────────── */
    xVitalAlertGroup = xEventGroupCreate();
    if (xVitalAlertGroup == NULL) {
        printf("[FATAL] Event group creation failed — halting\n");
        while(1);
    }

    /* ── Tasks ───────────────────────────────────────────────────────────── */

    /* Logging task created first — must drain buffer before sensor tasks send */
    BaseType_t LT = xTaskCreate(vLoggingtask, "LoggingTask", 1024, NULL, 1, NULL);
    if (LT != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "LoggingTask"); while(1); }

    /* Sensor tasks — each monitors one physiological parameter */
    BaseType_t HR = xTaskCreate(vHeartRate, "HeartRate", 1024, NULL, 4, NULL);
    if (HR != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "HeartRate"); while(1); }

    BaseType_t SpO2 = xTaskCreate(vSpO2, "SpO2", 1024, NULL, 4, NULL);
    if (SpO2 != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "SpO2"); while(1); }

    BaseType_t BP = xTaskCreate(vBP, "BloodPressure", 1024, NULL, 3, NULL);
    if (BP != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "BloodPressure"); while(1); }

    BaseType_t Temp = xTaskCreate(vTemperature, "Temperature", 1024, NULL, 2, NULL);
    if (Temp != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "Temperature"); while(1); }

    /* Alert tasks — respond to threshold breaches */
    BaseType_t AT = xTaskCreate(vCriticalAlert, "CriticalAlert", 1024, NULL, 5, NULL);
    if (AT != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "CriticalAlert"); while(1); }

    /* xDisplayTaskHandle stored globally — sensor tasks use it for xTaskNotify */
    BaseType_t Display = xTaskCreate(vDisplayTask, "DisplayTask", 1024, NULL, 1, &xDisplayTaskHandle);
    if (Display != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "DisplayTask"); while(1); }

    /* System monitoring tasks */
    BaseType_t WatchDog = xTaskCreate(vWatchDogTask, "Watchdog", 1024, NULL, 6, NULL);
    if (WatchDog != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "Watchdog"); while(1); }

    /* Health monitor gets 2048-word stack — vTaskList() requires extra space */
    BaseType_t HM = xTaskCreate(vHealthMonitor, "HealthMonitor", 2048, NULL, 1, NULL);
    if (HM != pdPASS) { vLogError(ERR_TASK_CREATE_FAILED, "HealthMonitor"); while(1); }

    /* Hand control to FreeRTOS kernel — this call never returns */
    vTaskStartScheduler();

    return 0; /* Never reached */
}
