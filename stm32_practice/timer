#include "stm32f4xx.h"
#include <stdbool.h>
#include <stdio.h>

#define LED_PIN 13U
#define LED_PORT GPIOC
#define TIM2_PRESCALAR 8399U
#define TIM2_ARR 19U
#define TARGET_SAMPLE_MAX 500U
#define TIM2_PRIORITY 2U

#define UNUSED_DELAY(x) do{ (void) (x); } while(0)

volatile bool one_sec_elapsed=false;
void GPIO_Init(){
   RCC->AHB1ENR|=(1<<2);
   __IO uint32_t dummyRead= RCC->AHB1ENR;
   UNUSED_DELAY(dummyRead);
   GPIOC->MODER&= ~(3<<(13*2));
   GPIOC->MODER|= (1<<(13*2));
   GPIOC->OTYPER&= ~(1<<13);
   GPIOC->BSRR |= (1<<LED_PIN);
}

void TIM2_Init(){
   RCC->APB1ENR|= (1<<0);
   __IO uint32_t dummyRead= RCC->AHB1ENR;
   UNUSED_DELAY(dummyRead);
   TIM2->PSC=TIM2_PRESCALAR; //84 MHz/8400=10KHz
   TIM2->ARR=TIM2_ARR;  //20 ticks/10KHz=2ms
   TIM2->CR1|= (1<<7);
   TIM2->DIER|= (1<<0);
   NVIC_SetPriority(TIM2_IRQn,TIM2_PRIORITY);
   NVIC_EnableIRQ(TIM2_IRQn);
   TIM2->CR1|= (1<<0);
}

void TIM2_IRQHandler(void){
   static volatile uint32_t SampleCount;
   if(TIM2->SR & (1<<0)){
      TIM2->SR&= ~(1<<0);
      SampleCount++;
      if(SampleCount>=500){
         GPIOC->ODR^= (1<<LED_PIN);
         one_sec_elapsed=true;
         SampleCount=0;
      }
   }
}

int main(void){
   SystemInit();
   GPIO_Init();
   TIM2_Init();
   while(1){
      if(one_sec_elapsed==true){
         one_sec_elapsed=false;
         printf("ECG samples collected: %u\n",(unsigned int)TARGET_SAMPLE_MAX);
      }
   }
}
