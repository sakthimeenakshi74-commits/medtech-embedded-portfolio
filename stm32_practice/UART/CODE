#include "ARMCM4.h"
#include <stdbool.h>
#include <stdio.h>
#include <string.h>

#define BUS_CLK_APB1 16000000
#define UART_BAUD_RATE 115200
#define USART_BRR_VALUE 139
#define TIM2PSC 8399
#define TIM2ARR 9999

volatile bool vital_flag=false;

/* GPIO Configuration Registers */
void UART_GPIO_Init(void){
   // RCC AHB1ENR Bit 0: Sets GPIOA peripheral clock enable state high
   RCC->AHB1ENR|= (1<<0);
   
   // GPIOA MODER: Configures pin data types. Pin 2 (Bits 4-5) and Pin 3 (Bits 6-7)
   GPIOA->MODER&= ~(3<<(2*2)); // Clears configuration mode bits for PA2
   GPIOA->MODER|= (2<<(2*2));  // Sets PA2 to Alternate Function Mode (0b10)
   GPIOA->OSPEEDR|= (3<<(2*2)); // Sets PA2 output speed configuration to Very High Speed (0b11)
   
   // GPIOA AFR[0] (Low Register): Configures pin alternate function mapping multiplexers (4 bits per pin)
   GPIOA->AFR[0] &= ~(0XF<<(2*4)); // Clears alternate function bits for PA2 (Bits 8-11)
   GPIOA->AFR[0] |= (7<<(2*4));    // Maps PA2 to Alternate Function 7 (0b0111) for USART2_TX

   GPIOA->MODER&= ~(3<<(3*2)); // Clears configuration mode bits for PA3
   GPIOA->MODER|= (2<<(3*2));  // Sets PA3 to Alternate Function Mode (0b10)
   GPIOA->AFR[0] &= ~(0XF<<(3*4)); // Clears alternate function bits for PA3 (Bits 12-15)
   GPIOA->AFR[0] |= (7<<(3*4));    // Maps PA3 to Alternate Function 7 (0b0111) for USART2_RX
}

/* USART2 Configuration Registers */
void USART2_Init(void){
   // RCC APB1ENR Bit 17: Sets USART2 clock gating enable bit high
   RCC->APB1ENR|= (1<<17);
   
   // USART2 BRR: Controls transmission speed matching (Baud Rate Register fraction/mantissa)
   USART2->BRR=USART_BRR_VALUE;
   
   // USART2 CR1 (Control Register 1): Toggles specific protocol parameters and interrupts
   USART2->CR1|= (1<<2);  // Bit 2 RE: Activates receiver state monitoring
   USART2->CR1|= (1<<3);  // Bit 3 TE: Activates transmitter output buffers
   USART2->CR1|= (1<<5);  // Bit 5 RXNEIE: Triggers hardware interrupt when incoming byte fills data register
   USART2->CR1|= (1<<13); // Bit 13 UE: Powers up the root USART peripheral state machine
   
   // Core Core NVIC Configuration Registers
   NVIC_SetPriority(USART2_IRQn,1); // Writes Priority level to the NVIC interrupt allocation priority map
   NVIC_EnableIRQ(USART2_IRQn);    // Unmasks processing line mask inside Core Nested Vector Interrupt Controller
}

/* TIM2 General Purpose Timer Configuration Registers */
void TIM2_Init(void){
   // RCC APB1ENR Bit 0: Sets TIM2 internal hardware core clock gate line high
   RCC->APB1ENR|= (1<<0);
   
   // TIM2 PSC & ARR: Control clock pre-scaling and auto-reload counting ceilings
   TIM2->PSC=15999;
   TIM2->ARR=999;
   
   // TIM2 DIER (DMA/Interrupt Enable Register) & CR1 (Control Register 1)
   TIM2->DIER|= (1<<0); // Bit 0 UIE: Enables CPU hardware interrupt trigger tracking on counter overflow events
   TIM2->CR1|= (1<<0);  // Bit 0 CEN: Engages Counter Enable, starting operational clock updates
   
   // Core Core NVIC Configuration Registers
   NVIC_SetPriority(TIM2_IRQn,2); // Sets execution context nesting tracking priority hierarchy
   NVIC_EnableIRQ(TIM2_IRQn);    // Arms CPU Core interrupt routing matrix line for TIM2 events
}

void USART2_SendByte(uint8_t byte){
   // USART2 SR Bit 7 TXE: Polls status flag until Transmit Data Register changes state to empty
   while(!(USART2->SR & (1<<7)));
   
   // USART2 DR: Low-level physical hardware interface holding register buffer for data byte handling
   USART2->DR=byte;
}

void USART2_SendString(const char* str){
   while(*str){
      USART2_SendByte((uint8_t) *str++);
   }
}

/* Asynchronous Vector ISR Routines */
void TIM2_IRQHandler(void){
   // TIM2 SR Bit 0 UIF: Evaluates status flag to check for dynamic Update Interrupt events
   if(TIM2->SR & (1<<0)){
      TIM2->SR&= ~(1<<0); // Clears sticky update interrupt status flag bit to block loop re-entry
      vital_flag=true;
   }
}

void USART2_IRQHandler(void){
   // USART2 SR Bit 5 RXNE: Evaluates status flag to verify if incoming byte is ready for extraction
   if(USART2->SR & (1<<5)){
      char command= USART2->DR; // Extracts data byte buffer contents (Automatically resets bit flag status)
      switch(command){
         case 'S':
            USART2_SendString("[CMD] Monitoring STARTED\r\n");
            break;
         case 'P':
            USART2_SendString("[CMD] Monitoring PAUSED\r\n");
            break;
         case 'R':
            USART2_SendString("[CMD] System RESET\r\n");
            break;
         default:
            USART2_SendString("[CMD] Unknown command\r\n");
      }
   }
}

int main(void){
   SystemInit(); // Core System Architecture initial baseline system clock layout configuration
   UART_GPIO_Init();
   USART2_Init();
   TIM2_Init();
   while(1){
      if(vital_flag){
         vital_flag=false;
         USART2_SendString("[VITALS] HR:72bpm SpO2:98% Temp:36.5C\r\n");
      }
   }
}
