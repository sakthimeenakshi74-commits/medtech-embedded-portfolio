/**
 * @file    main.c
 * @brief   Patient Vital Signs Monitor — FreeRTOS POSIX Simulation
 * @author  Sakthi
 * @version 1.0.0
 * @date    2026
 *
 * @details This project implements a production-inspired real-time patient
 *          monitoring system using FreeRTOS, simulated on Linux via the
 *          FreeRTOS POSIX port. It monitors four vital signs concurrently
 *          using independent prioritized tasks, with a unified telemetry
 *          logging pipeline, multi-vital alert aggregation, direct UI
 *          notifications, and a software watchdog for task liveness tracking.
 *
 *          System Architecture:
 *          @code
 *          ┌──────────────────────────────────────────────────────────┐
 *          │  Sensor Tasks: HR(P4), SpO2(P4), BP(P3), Temp(P2)       │
 *          │       │                │                                 │
 *          │  Stream Buffer    Event Group         Task Notification  │
 *          │  (telemetry log)  (abnormal detect)   (UI alert)        │
 *          │       │                │                    │            │
 *          │  Logging Task    Critical Alert Task   Display Task     │
 *          │  (P1)            (P5)                  (P1)             │
 *          │                                                          │
 *          │  Watchdog Task (P6) ──► Safe Shutdown on failure        │
 *          │  Health Monitor (P1) ──► System diagnostics every 10s  │
 *          └──────────────────────────────────────────────────────────┘
 *          @endcode
 *
 *          FreeRTOS APIs Demonstrated:
 *          - xTaskCreate, vTaskDelay, taskENTER/EXIT_CRITICAL
 *          - xStreamBufferCreate, xStreamBufferSend, xStreamBufferReceive
 *          - xEventGroupCreate, xEventGroupSetBits, xEventGroupWaitBits
 *          - xTaskNotify (eSetBits), xTaskNotifyWait
 *          - xSemaphoreCreateMutex, xSemaphoreTake, xSemaphoreGive
 *          - vTaskList, xPortGetFreeHeapSize
 *
 *          Defensive Coding Patterns (IEC 62304 inspired):
 *          - NULL/pdPASS validation on all FreeRTOS object creation
 *          - Bounded mutex timeouts (100ms) to detect deadlocks
 *          - Sensor data range validation before processing
 *          - Software watchdog with per-task liveness bitmask
 *          - Controlled safe shutdown on system fault detection
 *
 * @note    Simulated on Linux/WSL using FreeRTOS POSIX Simulator.
 *          In production hardware (STM32/ESP32), sensor reads would
 *          replace rand() calls and hardware IWDG would replace the
 *          software watchdog shutdown pattern.
 *
 * @see     https://www.freertos.org/Documentation/RTOS_book.html
 * @see     IEC 62304:2006 — Medical Device Software Lifecycle Processes
 */

#include <stdio.h>
#include "FreeRTOS.h"
#include "task.h"
#include "timers.h"
#include <stdlib.h>
#include "semphr.h"
#include "event_groups.h"
#include "stream_buffer.h"

/* ========================================================================== */
/*                        BITMASK DEFINITIONS                                 */
/* ========================================================================== */

/** @defgroup EventGroupBits Event Group Alert Bitmasks
 *  @brief Bit flags used to signal abnormal vital parameters via event group.
 *  @{
 */
#define BIT_HR_ABNORMAL   (1 << 0) /**< Heart rate outside 60-100 BPM range   */
#define BIT_SpO2_ABNORMAL (1 << 1) /**< SpO2 below 96% — hypoxemia risk        */
#define BIT_BP_ABNORMAL   (1 << 2) /**< Blood pressure outside 80-120 mmHg    */
#define BIT_TEMP_ABNORMAL (1 << 3) /**< Temperature above 100.0°F — fever      */
/** @} */

/** @defgroup WatchdogBits Software Watchdog Liveness Bitmasks
 *  @brief Each sensor task sets its bit every cycle to prove it is alive.
 *  @{
 */
#define WATCHDOG_HR   (1 << 0) /**< Heart rate task alive flag   */
#define WATCHDOG_SPO2 (1 << 1) /**< SpO2 task alive flag         */
#define WATCHDOG_BP   (1 << 2) /**< Blood pressure task alive flag */
#define WATCHDOG_TEMP (1 << 3) /**< Temperature task alive flag  */

/** @brief All four sensor tasks must kick within the watchdog window */
#define WATCHDOG_ALL_BITS (WATCHDOG_HR | WATCHDOG_SPO2 | WATCHDOG_BP | WATCHDOG_TEMP)
/** @} */

/** @defgroup NotifyBits Task Notification UI Alert Flags
 *  @brief Bit flags sent directly to display task via xTaskNotify (eSetBits).
 *  @{
 */
#define NOTIFY_HR_ALERT   (1UL << 0) /**< Heart rate UI alert flag   */
#define NOTIFY_SPO2_ALERT (1UL << 1) /**< SpO2 UI alert flag         */
#define NOTIFY_BP_ALERT   (1UL << 2) /**< Blood pressure UI alert flag */
#define NOTIFY_TEMP_ALERT (1UL << 3) /**< Temperature UI alert flag  */
/** @} */

/* ========================================================================== */
/*                        GLOBAL HANDLES & STATE                              */
/* ========================================================================== */

/**
 * @brief Software watchdog kick register.
 * @note  Each sensor task ORs its bit into this register every cycle.
 *        The watchdog task checks all bits are set within a 5-second window.
 *        Declared volatile to prevent compiler from caching the value across
 *        preemptive context switches between tasks.
 */
volatile uint32_t ulWatchdogKickRegister = 0;

/** @brief Event group handle — broadcasts abnormal vital parameter events */
EventGroupHandle_t   xVitalAlertGroup;

/** @brief Mutex serializing multi-producer writes to xLogStreamBuffer */
SemaphoreHandle_t    xBufferMutex;

/** @brief Mutex protecting direct printf calls (watchdog status, UI alerts) */
SemaphoreHandle_t    xPrintMutex;

/** @brief Task handle of display task — target for xTaskNotify UI alerts */
TaskHandle_t         xDisplayTaskHandle;

/** @brief Stream buffer carrying formatted telemetry strings to logging task */
StreamBufferHandle_t xLogStreamBuffer;

/* ========================================================================== */
/*                        TYPE DEFINITIONS                                    */
/* ========================================================================== */

/**
 * @brief System fault classification codes.
 * @details Used by vLogError() to categorize faults and route them to the
 *          telemetry stream for persistent logging.
 */
typedef enum {
    ERR_NONE            = 0, /**< No error — nominal operation              */
    ERR_QUEUE_FULL,          /**< Queue send rejected — buffer at capacity  */
    ERR_MUTEX_TIMEOUT,       /**< Mutex not acquired within timeout window  */
    ERR_INVALID_DATA,        /**< Sensor reading outside valid physical range */
    ERR_STACK_OVERFLOW,      /**< Task stack high water mark critically low */
    ERR_TASK_CREATE_FAILED,  /**< xTaskCreate returned non-pdPASS           */
    ERR_WATCHDOG_TIMEOUT     /**< Task failed to kick watchdog within window */
} ErrorCode_t;

/**
 * @brief Patient physiological data container.
 * @details Declared locally inside each sensor task to ensure full data
 *          isolation — each task owns its own copy on its private stack,
 *          eliminating inter-task race conditions without requiring a mutex.
 */
typedef struct {
    int   heartRate; /**< Heart rate in BPM.         Valid range: 30–200    */
    int   SpO2;      /**< Blood oxygen saturation %.  Valid range: 70–100   */
    float Temp;      /**< Body temperature in °F.    Valid range: 90.0–110.0 */
    int   BP;        /**< Blood pressure in mmHg.    Valid range: 60–180    */
} PatientData_t;

/* ========================================================================== */
/*                        UTILITY FUNCTIONS                                   */
/* ========================================================================== */

/**
 * @brief Thread-safe system fault logger.
 * @details Formats an error record and pushes it into the shared stream buffer
 *          for consumption by the logging task. Uses xBufferMutex to serialize
 *          concurrent writes from multiple producer tasks.
 * @param error    ErrorCode_t value classifying the fault condition.
 * @param taskName Null-terminated string identifying the faulting context.
 * @note   Mutex timeout is bounded to 100ms to prevent task starvation
 *         if a deadlock condition is present in the system.
 */
void vLogError(ErrorCode_t error, const char *taskName) {
    char cTxBuffer[128];
    int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                       "[Error Log] Code: %d | Error: %s\n", error, taskName);
    if (len > 0) {
        /* Serialize write — multiple tasks call this concurrently */
        xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100));
        xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
        xSemaphoreGive(xBufferMutex);
    }
}

/* ========================================================================== */
/*                        SENSOR TASKS                                        */
/* ========================================================================== */

/**
 * @brief Heart rate sensor simulation and telemetry task.
 * @details Simulates a 2Hz (500ms) heart rate sensor. Validates the reading
 *          against the physically possible range before transmission.
 *          Uses dual-path alerting: stream buffer for logging and event group
 *          for critical alert task, plus task notification for UI display.
 *          Kicks the software watchdog after each successful read cycle.
 * @param pvParametr FreeRTOS task parameter — unused.
 * @note   Clinical alert threshold: <60 BPM (bradycardia) or >100 BPM (tachycardia).
 *         Physical validity range: 30–200 BPM.
 * @priority 4
 */
void vHeartRate(void *pvParametr) {
    char cTxBuffer[128];
    PatientData_t PatientData; /* Task-local — no shared memory race risk */

    while(1) {
        /* Simulate atomic hardware sensor register read */
        taskENTER_CRITICAL();
        PatientData.heartRate = 70 + (rand() % 50);
        taskEXIT_CRITICAL();

        /* Prove task is alive to watchdog monitor */
        ulWatchdogKickRegister |= WATCHDOG_HR;

        /* Discard physically impossible readings — sensor fault or noise */
        if (PatientData.heartRate < 30 || PatientData.heartRate > 200) {
            vLogError(ERR_INVALID_DATA, "Invalid HR reading");
            vTaskDelay(pdMS_TO_TICKS(1000));
            continue;
        }

        /* Push formatted telemetry into stream buffer */
        if (xSemaphoreTake(xBufferMutex, pdMS_TO_TICKS(100)) != pdTRUE) {
            vLogError(ERR_MUTEX_TIMEOUT, "HeartRate: BufferMutex timeout");
        } else {
            int len = snprintf(cTxBuffer, sizeof(cTxBuffer),
                               "Heart Rate: %d BPM\n", PatientData.heartRate);
            if (len > 0) {
                xStreamBufferSend(xLogStreamBuffer, cTxBuffer, len, portMAX_DELAY);
            }
            xSemaphoreGive(xBufferMutex);
        }

        /* Dual-path alert on clinical threshold breach */
        if (PatientData.heartRate < 60 || PatientData.heartRate > 100) {
            xTaskNotify(xDisplayTaskHandle, NOTIFY_HR_ALERT, eSetBits);
            xEventGroupSetBits(xVitalAlertGroup, BIT_HR_ABNORMAL);
        }

        vTaskDelay(pdMS_TO_TICKS(500)); /* 2Hz sampling rate */
    }
}

/**
 * @brief SpO2 (blood oxygen saturation) sensor simulation task.
